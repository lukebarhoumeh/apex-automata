{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/__tests__/**/*",
    "src/backtesting/advanced-backtest-engine.ts",
    "src/backtesting/data-loader.ts",
    "src/exchanges/multi-exchange-connector.ts",
    "src/exchanges/ultra-fast-websocket.ts",
    "src/trading/native-engine.ts",
    "src/native/**/*"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
