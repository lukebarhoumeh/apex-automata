# Frontend (Vite) environment variables
# Copy to `.env` and fill in values.

VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional legacy key fallback (JWT anon key)
VITE_SUPABASE_ANON_KEY=""

# CoinDesk News + Sentiment (optional). Only required when the
# `meta_filter.coindesk_sentiment.enabled` flag is true in
# atlas/config/guardrails.yaml. Free tier sunsets 2026-05-21; verify tier
# before enabling.
COINDESK_API_KEY=
COINDESK_API_KEY_NAME=

