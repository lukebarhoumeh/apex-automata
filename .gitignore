# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment / secrets (per AGENTS.md)
.env
.env.*
!.env.example

# Local-only runtime artifacts.
# We ignore the *contents* of these dirs (not the dirs themselves) so that
# operational scripts can still be re-included below. Git can't re-include
# a file if a parent directory is wholesale ignored.
atlas/var/tmp/*
atlas/var/tmp/monitor/*
atlas/var/backtest_results/

# Track operational monitor scripts (pulse, etc.) even though their
# parent dir is otherwise local-only runtime data. Logs, snapshots, and
# captured run files stay ignored via the directory contents rule above.
!atlas/var/tmp/monitor/
!atlas/var/tmp/monitor/pulse.sh
!atlas/var/tmp/monitor/test-pulse-fix.sh

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local backtest artifacts (stdout dumps, reports, session folders)
atlas/var/backtest_results/
